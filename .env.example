# Copy this file's contents into your Vercel project's Environment Variables
# (Project Settings -> Environment Variables). Never commit a real .env file.

# From your Notion integration (notion.so/my-integrations)
NOTION_TOKEN=

# The database ID from the Notion database's URL (the 32-char id right after
# notion.so/ and before any ?v= query string)
NOTION_DATABASE_ID=

# Optional: only needed if you want AI to fill in days/categories that have
# no matching row in your Notion database. Get one at console.anthropic.com
ANTHROPIC_API_KEY=
