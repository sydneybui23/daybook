rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Your own profile + personal journal entries — only you can read or write them.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        // lets the public Explore feed find entries marked public across every account
        allow read: if request.auth != null && resource.data.public == true;
      }

      // Daily habit tracker: one doc per date holding which habits you checked off.
      match /habitLogs/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Circle metadata (name/description/cover/members) is readable by any signed-in
    // user so an invite link can show a preview before joining. Joining is just
    // adding your own uid, which this update rule allows for anyone.
    match /circles/{circleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if request.auth != null && request.auth.uid in resource.data.memberUids;

      // Entries shared inside a circle, and its general chat doc, are only
      // visible to actual members.
      match /{document=**} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberUids;
      }
    }

    // A "follow" is its own doc (id: "{followerUid}_{followingUid}") so
    // follower counts can be queried for anyone without exposing their
    // private profile doc. Readable by any signed-in user; only the
    // follower themselves can create or remove their own follow.
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerUid;
    }
  }
}
